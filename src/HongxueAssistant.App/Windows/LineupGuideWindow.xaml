<Window x:Class="HongxueAssistant.App.Windows.LineupGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="攻略流程" Width="960" Height="700" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        Icon="{StaticResource AspaLogo}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>
    <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Style="{StaticResource DialogTitleBar}" MouseLeftButtonDown="OnTitleBarDrag">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Tag="{StaticResource IconClose}" Style="{StaticResource DialogCloseButton}"
                            ToolTip="关闭" Click="OnClose" />
                    <TextBlock Text="攻略流程" Style="{StaticResource DialogTitleText}" />
                </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Padding="16,12" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock x:Name="GuideTitleText" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ComboBox x:Name="GuideTabs" DisplayMemberPath="DisplayTitle" SelectionChanged="OnGuideTabChanged" MinHeight="30" />
                    <TextBlock x:Name="GuideMetaText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,7,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <Button x:Name="ApplyGuideButton" DockPanel.Dock="Right" Content="替换草稿阶段"
                                Style="{StaticResource DialogPrimaryButton}" Click="OnApplyGuide" Margin="10,0,0,0" />
                        <ComboBox x:Name="GuideTargetPhase" DockPanel.Dock="Right" MinWidth="90" MinHeight="30" />
                        <TextBlock Text="复制本页阵容到" VerticalAlignment="Center" Margin="0,0,10,0" />
                    </DockPanel>
                    <TextBlock x:Name="GuideApplyStatus" Text="仅替换所选草稿阶段，保存后生效；可在编辑器撤销修改。推荐装备不会自动分配。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,14">
                    <TextBlock Text="运营思路" Style="{StaticResource FilterSectionTitle}" Margin="0,0,0,7" />
                    <TextBox x:Name="GuideNotesText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                             Style="{StaticResource DialogTextBox}" BorderThickness="0" MinHeight="45" Padding="8" />
                    <TextBlock Text="推荐干员 · 技能与模组为攻略原始选择" Style="{StaticResource FilterSectionTitle}" Margin="0,16,0,8" />
                    <ItemsControl x:Name="GuideOperatorsHost">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,0,0,5" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RowCornerRadius}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.1*" /><ColumnDefinition Width="0.55*" />
                                            <ColumnDefinition Width="1.3*" /><ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding OperatorName}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding EliteDisplay}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="2" Margin="8,0" ToolTip="{Binding SkillId}">
                                            <TextBlock Text="技能" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SkillDisplay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Margin="8,0" ToolTip="{Binding ModuleId}">
                                            <TextBlock Text="模组" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding ModuleDisplay}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="推荐装备 · 作者未指定佩戴者" Style="{StaticResource FilterSectionTitle}" Margin="0,16,0,8" />
                    <ItemsControl x:Name="GuideEquipmentHost">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,5" Margin="0,0,6,6" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="{DynamicResource RowCornerRadius}">
                                    <Border.ToolTip>
                                        <ToolTip>
                                            <StackPanel MaxWidth="380">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding DisplayDescription}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                <TextBlock Text="{Binding ItemId}" FontSize="10" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </ToolTip>
                                    </Border.ToolTip>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="目标盟约" Style="{StaticResource FilterSectionTitle}" Margin="0,12,0,8" />
                    <TextBlock x:Name="GuideBondsText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="原始技能、模组及回合数据随阵容保存与分享；本地规划仍使用当前模式数据。"
                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,16,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
